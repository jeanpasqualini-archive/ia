#!/usr/bin/env php
<?php

declare(strict_types=1);

// php-tui/term still declares implicitly nullable parameters, which PHP 8.4
// reports when the class is loaded. Any such notice would be printed straight
// into the alternate screen and corrupt the dashboard.
error_reporting(E_ALL & ~E_DEPRECATED);

require __DIR__ . '/vendor/autoload.php';

exit((new ApplicationConsole())->run());
